# VaxaGuard Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas URI or leave empty to use local in-memory MongoDB for instant zero-config testing
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaxaguard?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets & Expiry
JWT_SECRET=vaxaguard_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Client URL (for CORS in production)
CLIENT_URL=http://localhost:5000

# File Upload Settings
UPLOAD_DIR=uploads/certificates
MAX_FILE_SIZE_MB=5

# Optional SMTP Settings for Email Reminders (Nodemailer)
# If not configured, notification service gracefully logs and persists in-app alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VaxaGuard Alerts" <no-reply@vaxaguard.org>

# Scheduler Configuration (node-cron expression: runs daily at 08:00 AM)
SCHEDULER_CRON=0 8 * * *
DUE_SOON_DAYS=14
